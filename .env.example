# Variables d'environnement (jamais commitées ; en production, à définir sur Render).

# --- Obligatoires en production ---
DATABASE_URL=postgres://user:password@host:5432/dbname   # Postgres (Neon). Sans elle, le développement utilise PGlite (.data/pglite).
OPENAI_API_KEY=                                           # clé API OpenAI
APIFY_TOKEN=                                              # token API Apify
APP_PASSWORD=                                             # mot de passe partagé de l'application. Sans lui, l'API répond 503 en production.

# --- Optionnelles ---
# SESSION_SECRET=                    # secret de signature du cookie de session (défaut : dérivé de APP_PASSWORD)
# TRUST_PROXY=1                      # nombre de proxys de confiance devant l'API (1 sur Render) : nécessaire pour lire l'IP réelle du client
# CORS_ORIGIN=                       # origines autorisées (liste séparée par des virgules) ; inutile quand le front est servi par l'API

# Quotas sur les actions coûteuses (IA, Apify) — les lectures et le suivi d'avancement ne comptent pas
# RATE_LIMIT_IP_PER_HOUR=40          # par adresse IP et par heure
# QUOTA_COOKIE_PER_HOUR=30           # par session (cookie) et par heure
# QUOTA_GLOBAL_PER_DAY=300           # pour toute l'application et par jour

# Apify : limites par appel
# APIFY_RESULT_LIMIT=5               # annonces conservées par appel (l'acteur impose >= 10 examinées)
# APIFY_CANDIDATE_LIMIT=10
# APIFY_MAX_CHARGE_USD=0.10
# APIFY_TIMEOUT_SECONDS=120

# Worker serveur
# WORKER_INTERVAL_MS=3000            # fréquence de la boucle
# WORKER_LEASE_MS=300000             # durée du bail (verrou en base) avant reprise par un autre processus
# WORKER_CONCURRENCY=2               # recherches traitées en parallèle

# Développement local
# OPENAI_BASE_URL=                   # API compatible OpenAI (tests)
# APIFY_BASE_URL=                    # remplace https://api.apify.com (tests)
# LOGISCOPE_PGLITE_DIR=              # dossier de la base locale (défaut .data/pglite ; memory:// pour une base jetable)

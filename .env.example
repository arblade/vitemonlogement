# Variables d'environnement (jamais commitées ; en production, à définir sur Render).

# --- Obligatoires en production ---
DATABASE_URL=postgres://user:password@host:5432/dbname   # Postgres (Neon). Sans elle, le développement utilise PGlite (.data/pglite).
OPENAI_API_KEY=                                           # clé API OpenAI (interprétation de la demande, analyse des annonces)
APIFY_TOKEN=                                              # token API Apify (lecture de Le Bon Coin)
APP_PASSWORD=                                             # CODE D'INVITATION : seules les personnes qui le connaissent créent un compte (lien /?invite=CODE). Sans lui, l'API répond 503 en production.
SESSION_SECRET=                                           # signe les cookies de session, les liens de désinscription et de mot de passe (Render le génère : generateValue)

# --- E-mails (Resend) : sans clé, rien ne part, le site fonctionne pareil ---
# RESEND_API_KEY=                    # clé « Sending access » du domaine vérifié chez Resend
# MAIL_FROM=Vite mon logement <alertes@vitemonlogement.fr>   # expéditeur (domaine vérifié chez Resend)
# MAIL_REPLY_TO=                     # adresse de réponse
# ALERT_EMAIL=                       # reçoit les alertes d'exploitation (veille en échec 3 relèves d'affilée)
# PUBLIC_URL=https://vitemonlogement.fr   # adresse du site dans les liens des e-mails et les aperçus de partage (défaut : RENDER_EXTERNAL_URL, fournie par Render)

# --- Facultatives ---
# GOOGLE_MAPS_API_KEY=               # temps et tracés de trajet (Google Routes API) ; sans elle, la carte s'affiche sans durée
# GOOGLE_ROUTES_PER_DAY=300          # plafond quotidien de calculs de trajet
# TRUST_PROXY=1                      # nombre de proxys de confiance devant l'API (1 sur Render) : nécessaire pour lire l'IP réelle du client
# CORS_ORIGIN=                       # origines autorisées (liste séparée par des virgules) ; inutile quand le front est servi par l'API
# LOG_LEVEL=info

# Quotas sur les actions coûteuses (IA, Apify) — les lectures et le suivi d'avancement ne comptent pas
# RATE_LIMIT_IP_PER_HOUR=40          # par adresse IP et par heure
# QUOTA_COOKIE_PER_HOUR=30           # par session et par heure
# QUOTA_GLOBAL_PER_DAY=300           # pour toute l'application et par jour

# Lecture des annonces
# ONE_SHOT_LIMIT=15                  # recherche ponctuelle : les N plus récentes (35 au plus)
# LIVE_SEARCH_DAYS=4                 # création d'une veille : remonter N jours
# READ_MAX_PAGES=3                   # pages de 35 annonces lues au plus par passage
# FIRST_ANALYSIS=20                  # annonces analysées d'emblée ; les suivantes quand elles s'affichent
# APIFY_MAX_CHARGE_USD=0.10          # plafond de dépense par run Apify
# APIFY_TIMEOUT_SECONDS=120
# SELOGER_CANDIDATE_LIMIT=6          # sources secondaires (désactivées dans le code pour l'instant)
# PAP_CANDIDATE_LIMIT=4

# Veille quotidienne
# WATCH_IDLE_DAYS=7                  # pause après N jours sans visite
# WATCH_SPREAD_SECONDS=300           # relèves étalées de 0 à N secondes après l'heure choisie (0 : à l'heure pile)

# Worker serveur
# WORKER_INTERVAL_MS=3000            # fréquence de la boucle
# WORKER_LEASE_MS=300000             # durée du bail (verrou en base) avant reprise par un autre processus
# WORKER_CONCURRENCY=2               # recherches traitées en parallèle

# Développement et tests (remplacent les adresses des services, pour des faux serveurs locaux)
# OPENAI_BASE_URL=
# APIFY_BASE_URL=
# RESEND_BASE_URL=
# GEOCODER_BASE_URL=
# GOOGLE_ROUTES_BASE_URL=
# LOGISCOPE_PGLITE_DIR=              # dossier de la base locale (défaut .data/pglite ; memory:// pour une base jetable)
# SCENARIO_DATABASE_URL=             # simulation de veille sur un vrai Postgres (base vide)
